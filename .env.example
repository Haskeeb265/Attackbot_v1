# Copy this to .env and fill in values for local development.
# Never commit the actual .env file.

# ── PostgreSQL ─────────────────────────────────────────────────────────
POSTGRES_USER=attackbot
POSTGRES_PASSWORD=attackbot
POSTGRES_DB=attackbot

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── RabbitMQ ───────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=attackbot
RABBITMQ_DEFAULT_PASS=attackbot

# ── MinIO ──────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Vault (dev mode) ───────────────────────────────────────────────────
VAULT_DEV_ROOT_TOKEN_ID=dev-root-token

# ── Neo4j ──────────────────────────────────────────────────────────────
NEO4J_AUTH=neo4j/attackbot

# Reporter runtime overrides (optional)
# Comma-separated retry backoff schedule for reporter-worker retries.
REPORT_TASK_RETRY_BACKOFF_SECONDS_STR=60,300,600
# Comma-separated report IDs to force upload failure in reporter-task; use "*" to force all.
FORCE_UPLOAD_FAILURE_REPORT_IDS_STR=

# Integration test toggles (optional)
RUN_REPORTER_ORGANIC_INTEGRATION=0
RUN_REPORTER_FAILURE_INTEGRATION=0
RUN_REPORTER_DLQ_INTEGRATION=0

# RabbitMQ management API overrides used by integration tests (optional)
RABBITMQ_MGMT_URL=http://localhost:15672/api
RABBITMQ_MGMT_USER=attackbot
RABBITMQ_MGMT_PASS=attackbot
