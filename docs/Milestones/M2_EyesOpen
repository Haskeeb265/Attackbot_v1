## 9. ♻️ Reconciler

The reconciler runs every 5 minutes and retries programs where `queued_for_scan = true`. It is the only component that clears that flag.

```python
# backend/services/scraper/reconciler.py
from shared.logging import get_logger
from .repository import ProgramRepository
from .publisher import ScanJobPublisher

log = get_logger(__name__)
_repo = ProgramRepository()


class Reconciler:
    """
    Retries queued_for_scan programs that failed to publish.

    Query:  programs WHERE queued_for_scan = true
                      AND last_scraped_at > NOW() - INTERVAL '{stale_days} days'

    Why the stale window?
      Programs scraped more than N days ago may have changed scope or become inactive.
      Re-publishing stale data as a fresh scan job risks incorrect scope enforcement.
      The program will be re-queued naturally on the next scheduled scrape cycle.

    The reconciler:
      - Republishes each qualifying program
      - On success: clears queued_for_scan (via ScanJobPublisher)
      - On failure: leaves queued_for_scan = true for the next cycle
    """

    def __init__(self, publisher: ScanJobPublisher, stale_days: int = 7):
        self._publisher  = publisher
        self._stale_days = stale_days

    async def reconcile(self) -> dict:
        """
        Run one reconciliation cycle.
        Returns a summary dict for observability/logging.
        """
        programs = await _repo.get_programs_pending_reconcile(self._stale_days)

        if not programs:
            log.info("reconciler_nothing_to_reconcile")
            return {"attempted": 0, "succeeded": 0, "failed": 0}

        log.info("reconciler_starting", pending=len(programs))

        succeeded = 0
        failed    = 0

        for program in programs:
            full_program = await _repo.get_program_with_scopes(program.program_id)
            if not full_program or not full_program.scopes:
                log.warning("reconciler_no_scopes", program_id=str(program.program_id))
                failed += 1
                continue

            ok = await self._publisher.publish_scan_job(
                program = full_program,
                scopes  = full_program.scopes,
            )
            if ok:
                succeeded += 1
            else:
                failed += 1

        summary = {"attempted": len(programs), "succeeded": succeeded, "failed": failed}
        log.info("reconciler_complete", **summary)
        return summary
```

