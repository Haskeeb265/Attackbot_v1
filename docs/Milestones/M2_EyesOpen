### 5.2 Core HTTP Client with Retry

```python
@register("hackerone")
class HackerOneCollector(BaseCollector):
    """
    HackerOne API collector.
    Auth:  HTTP Basic — api_username as username, api_token as password.
    Docs:  https://api.hackerone.com/customer-facing/
    """

    def __init__(self, api_username: str, api_token: str, page_size: int = H1_PAGE_SIZE,
                 max_retries: int = 3):
        self._auth       = (api_username, api_token)
        self._page_size  = page_size
        self._max_retries = max_retries
        self._client: httpx.AsyncClient | None = None

    async def _get_client(self) -> httpx.AsyncClient:
        if self._client is None or self._client.is_closed:
            self._client = httpx.AsyncClient(
                auth=self._auth,
                headers={"Accept": "application/json"},
                timeout=30.0,
            )
        return self._client

    async def _get_with_retry(
        self,
        url: str,
        params: dict | None = None,
    ) -> dict:
        """
        GET with automatic 429 back-off.
        Raises CollectorRateLimitError if all retries are exhausted.
        Raises CollectorAuthError on 401/403.
        """
        client = await self._get_client()
        for attempt in range(self._max_retries):
            try:
                resp = await client.get(url, params=params)
            except httpx.RequestError as e:
                log.warning("h1_request_error", url=url, attempt=attempt, error=str(e))
                await asyncio.sleep(5 * (attempt + 1))
                continue

            if resp.status_code == 429:
                retry_after = int(resp.headers.get("Retry-After", 60))
                log.warning("h1_rate_limited", retry_after=retry_after, attempt=attempt)
                await asyncio.sleep(retry_after)
                continue

            if resp.status_code in (401, 403):
                raise CollectorAuthError(
                    f"HackerOne authentication failed: {resp.status_code}. "
                    "Check api_username and api_token in Vault."
                )

            if resp.status_code == 404:
                raise CollectorError(f"HackerOne resource not found: {url}")

            resp.raise_for_status()
            return resp.json()

        raise CollectorRateLimitError(
            f"HackerOne rate limited after {self._max_retries} retries on {url}"
        )

    async def close(self) -> None:
        if self._client and not self._client.is_closed:
            await self._client.aclose()
```

### 5.3 Paginated Program Listing

```python
    async def _paginate(self, url: str, extra_params: dict | None = None) -> AsyncGenerator[dict, None]:
        """
        Generic paginator for all HackerOne list endpoints.
        Consistent pagination pattern: page[number] + page[size].
        Stops when the API returns an empty data array.
        """
        page = 1
        while True:
            params = {"page[number]": page, "page[size]": self._page_size}
            if extra_params:
                params.update(extra_params)

            data = await self._get_with_retry(url, params=params)
            items = data.get("data", [])

            if not items:
                break

            for item in items:
                yield item

            page += 1
            log.info("h1_pagination_page", url=url, page=page, count=len(items))
```

### 5.4 `fetch_listing()` — Program Listing

```python
    async def fetch_listing(self) -> list[RawProgram]:
        """
        Fetch all programs the authenticated user can access.
        Endpoint: GET /v1/hackers/programs
        For each program in the listing, fetch structured_scopes separately.
        """
        url = f"{H1_BASE_URL}/v1/hackers/programs"
        programs: list[RawProgram] = []

        async for item in self._paginate(url):
            handle = item["attributes"].get("handle", "")
            if not handle:
                continue
            try:
                raw = await self.fetch_details(handle)
                programs.append(raw)
                log.info("h1_program_fetched", handle=handle)
            except CollectorError as e:
                # Log and skip — don't abort the entire listing on one program failure
                log.warning("h1_program_fetch_failed", handle=handle, error=str(e))

        log.info("h1_listing_complete", total=len(programs))
        return programs
```

### 5.5 `fetch_details()` — Program Detail + Structured Scopes

```python
    async def fetch_details(self, handle: str) -> RawProgram:
        """
        Fetch full program detail and structured scopes.
        Uses /structured_scopes endpoint — NOT raw policy text.
        """
        # ── Program detail ─────────────────────────────────────────
        detail_url  = f"{H1_BASE_URL}/v1/hackers/programs/{handle}"
        detail_data = await self._get_with_retry(detail_url)
        attrs       = detail_data.get("data", {}).get("attributes", {})

        # ── Structured scopes ──────────────────────────────────────
        # CRITICAL: Use structured_scopes, NOT raw policy text.
        # structured_scopes returns pre-parsed asset_type + value fields
        # that map directly to program_scopes table. Raw policy is markdown
        # and would require a complex parser.
        scopes_url = f"{H1_BASE_URL}/v1/hackers/programs/{handle}/structured_scopes"
        scope_entries: list[RawScopeEntry] = []

        async for scope_item in self._paginate(scopes_url):
            scope_attrs = scope_item.get("attributes", {})
            asset_type_raw = scope_attrs.get("asset_type", "OTHER")
            canonical_type = H1_ASSET_TYPE_MAP.get(asset_type_raw, "api")

            # H1 uses eligible=True for in_scope, eligible=False for out_of_scope
            eligible   = scope_attrs.get("eligible_for_bounty", True)
            scope_type = "in_scope" if eligible else "out_of_scope"

            scope_entries.append(RawScopeEntry(
                asset_type = canonical_type,
                value      = scope_attrs.get("asset_identifier", ""),
                scope_type = scope_type,
                notes      = scope_attrs.get("instruction", ""),
            ))

        # ── Policy ────────────────────────────────────────────────
        policy = RawPolicy(
            disclosure_policy    = attrs.get("policy", ""),
            testing_restrictions = attrs.get("testing_instructions", "").splitlines()
                                   if attrs.get("testing_instructions") else [],
            safe_harbor          = attrs.get("safe_harbor") == "safe_harbor",
        )

        return RawProgram(
            platform    = "hackerone",
            handle      = handle,
            name        = attrs.get("name", handle),
            url         = f"https://hackerone.com/{handle}",
            bounty_type = "paid" if attrs.get("offers_bounties") else "rep_only",
            max_bounty  = attrs.get("maximum_bounty_table", {}).get("value"),
            is_active   = attrs.get("state") == "public_mode",
            raw_policy  = detail_data.get("data", {}),
            scopes      = scope_entries,
            policy      = policy,
        )
```

