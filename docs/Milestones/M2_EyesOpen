## 7. 🗃️ Program Repository & Upsert Logic

The repository owns all DB reads/writes for scraper data. Upsert is the most critical method — it must never overwrite `queued_for_scan = true` with `false` during a rescrape.

```python
# backend/services/scraper/repository.py
import uuid
from datetime import datetime, timezone
from sqlalchemy import select, update
from sqlalchemy.dialects.postgresql import insert as pg_insert
from shared.db import get_session
from shared.logging import get_logger
from .models import Program, ProgramScope, ProgramPolicy
from .collectors.models import RawProgram
from .scope_parser import ScopeParser, ParsedScope

log = get_logger(__name__)
_scope_parser = ScopeParser()


class ProgramRepository:

    async def upsert(self, raw: RawProgram, normalized: dict) -> tuple[uuid.UUID, bool]:
        """
        Insert or update a program row. Returns (program_id, created: bool).

        Critical behaviour:
          - queued_for_scan is NEVER overwritten on update. If a previous scrape
            set it to True (publish failed), a rescrape must not reset it to False.
            The reconciler is the only thing that clears it.
          - last_scraped_at is always updated so the reconciler window is accurate.
          - Scopes are replaced on every scrape (delete + re-insert) because
            program scope can change without the handle changing.
          - raw_policy is preserved as a verbatim snapshot for debugging.
        """
        async with get_session() as session:
            # ── Upsert programs row ────────────────────────────────
            stmt = pg_insert(Program).values(
                platform        = normalized["platform"],
                handle          = normalized["handle"],
                name            = normalized["name"],
                url             = normalized["url"],
                bounty_type     = normalized["bounty_type"],
                max_bounty      = normalized["max_bounty"],
                is_active       = normalized["is_active"],
                raw_policy      = normalized["raw_policy"],
                last_scraped_at = datetime.now(timezone.utc),
                # queued_for_scan defaults to false on INSERT
            ).on_conflict_do_update(
                index_elements=["handle"],
                set_={
                    "name":            normalized["name"],
                    "url":             normalized["url"],
                    "bounty_type":     normalized["bounty_type"],
                    "max_bounty":      normalized["max_bounty"],
                    "is_active":       normalized["is_active"],
                    "raw_policy":      normalized["raw_policy"],
                    "last_scraped_at": datetime.now(timezone.utc),
                    "updated_at":      datetime.now(timezone.utc),
                    # INTENTIONALLY OMITTED: queued_for_scan
                    # On conflict, we never touch queued_for_scan.
                    # If it was set true by a failed publish, we leave it.
                },
            ).returning(Program.program_id, Program.created_at, Program.updated_at)

            result     = await session.execute(stmt)
            row        = result.fetchone()
            program_id = row.program_id
            created    = row.created_at == row.updated_at  # rough creation indicator

            # ── Replace scopes ─────────────────────────────────────
            # Delete existing scopes for this program and re-insert.
            # This is simpler and safer than a three-way diff.
            await session.execute(
                ProgramScope.__table__.delete().where(
                    ProgramScope.program_id == program_id
                )
            )
            parsed_scopes: list[ParsedScope] = _scope_parser.parse_all(raw.scopes)
            for ps in parsed_scopes:
                session.add(ProgramScope(
                    program_id = program_id,
                    scope_type = ps.scope_type,
                    asset_type = ps.asset_type,
                    value      = ps.value,
                    notes      = ps.notes,
                ))

            # ── Upsert policy ──────────────────────────────────────
            if raw.policy:
                policy_stmt = pg_insert(ProgramPolicy).values(
                    program_id            = program_id,
                    disclosure_policy     = raw.policy.disclosure_policy,
                    testing_restrictions  = raw.policy.testing_restrictions,
                    safe_harbor           = raw.policy.safe_harbor,
                ).on_conflict_do_update(
                    index_elements=["program_id"],
                    set_={
                        "disclosure_policy":    raw.policy.disclosure_policy,
                        "testing_restrictions": raw.policy.testing_restrictions,
                        "safe_harbor":          raw.policy.safe_harbor,
                    }
                )
                await session.execute(policy_stmt)

            log.info(
                "program_upserted",
                handle     = normalized["handle"],
                program_id = str(program_id),
                created    = created,
                scopes     = len(parsed_scopes),
            )
            return program_id, created

    async def set_queued_for_scan(self, program_id: uuid.UUID, queued: bool) -> None:
        async with get_session() as session:
            await session.execute(
                update(Program)
                .where(Program.program_id == program_id)
                .values(queued_for_scan=queued)
            )

    async def get_programs_pending_reconcile(self, stale_days: int = 7) -> list[Program]:
        """Return programs that failed to publish and are still within the active window."""
        async with get_session() as session:
            result = await session.execute(
                select(Program).where(
                    Program.queued_for_scan == True,
                    Program.last_scraped_at > sa_text(
                        f"NOW() - INTERVAL '{stale_days} days'"
                    )
                )
            )
            return list(result.scalars().all())

    async def get_program_with_scopes(self, program_id: uuid.UUID) -> Program | None:
        async with get_session() as session:
            result = await session.execute(
                select(Program).where(Program.program_id == program_id)
            )
            return result.scalar_one_or_none()

    async def list_programs(
        self,
        platform: str | None = None,
        is_active: bool | None = None,
        page: int = 1,
        page_size: int = 50,
    ) -> tuple[list[Program], int]:
        async with get_session() as session:
            query = select(Program)
            if platform:
                query = query.where(Program.platform == platform)
            if is_active is not None:
                query = query.where(Program.is_active == is_active)

            count_result = await session.execute(
                select(sa_func.count()).select_from(query.subquery())
            )
            total = count_result.scalar_one()

            result = await session.execute(
                query.offset((page - 1) * page_size).limit(page_size)
                     .order_by(Program.created_at.desc())
            )
            return list(result.scalars().all()), total
```

