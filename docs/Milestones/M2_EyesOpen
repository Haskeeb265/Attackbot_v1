```python
# tests/unit/scraper/test_repository_upsert.py
import pytest
from unittest.mock import AsyncMock, patch, MagicMock
from uuid import uuid4

@pytest.mark.asyncio
async def test_upsert_does_not_overwrite_queued_for_scan():
    """
    When a program already exists with queued_for_scan=True,
    a second upsert call must NOT reset it to False.
    This is the critical invariant of the upsert logic.
    """
    # This test verifies the SQL statement excludes queued_for_scan
    # from the on_conflict_do_update set_ dict.
    from backend.services.scraper.repository import ProgramRepository
    from backend.services.scraper.collectors.models import RawProgram, RawPolicy

    raw = RawProgram(
        platform="hackerone", handle="test_prog", name="Test", url="https://h1.com/test",
        bounty_type="paid", max_bounty=500, is_active=True, raw_policy={},
        policy=RawPolicy(),
    )
    normalized = {
        "platform": "hackerone", "handle": "test_prog", "name": "Test",
        "url": "https://h1.com/test", "bounty_type": "paid",
        "max_bounty": 500, "is_active": True, "raw_policy": {},
    }

    # Inspect the generated SQL to verify queued_for_scan is absent
    # from the SET clause of the INSERT ... ON CONFLICT ... DO UPDATE.
    # We do this by checking the update dict passed to on_conflict_do_update.
    captured_set_dict = {}

    original_on_conflict = None

    with patch("backend.services.scraper.repository.pg_insert") as mock_insert:
        mock_stmt = MagicMock()
        mock_insert.return_value = mock_stmt
        mock_stmt.values.return_value = mock_stmt

        def capture_on_conflict(index_elements, set_):
            captured_set_dict.update(set_)
            return mock_stmt

        mock_stmt.on_conflict_do_update.side_effect = capture_on_conflict
        mock_stmt.returning.return_value = mock_stmt

        with patch("backend.services.scraper.repository.get_session") as mock_session:
            mock_ctx = AsyncMock()
            mock_ctx.__aenter__ = AsyncMock(return_value=mock_ctx)
            mock_ctx.__aexit__ = AsyncMock(return_value=False)
            mock_ctx.execute = AsyncMock(return_value=MagicMock(fetchone=lambda: MagicMock(
                program_id=uuid4(), created_at="2026-01-01", updated_at="2026-01-02"
            )))
            mock_session.return_value = mock_ctx

            repo = ProgramRepository()
            try:
                await repo.upsert(raw, normalized)
            except Exception:
                pass  # We only care about the captured SET dict

    assert "queued_for_scan" not in captured_set_dict, (
        "queued_for_scan must NOT be in the ON CONFLICT DO UPDATE SET clause"
    )
