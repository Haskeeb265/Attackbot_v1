    background_tasks: BackgroundTasks,
    platform: str = Query(default="hackerone"),
):
    """
    Manually trigger a full scrape for the specified platform.
    The scrape runs as a background task — returns immediately.
    For scheduled scrapes, the APScheduler job handles this automatically.
    """
    # Import here to avoid circular at module load
    from .main import get_scheduler
    scheduler = get_scheduler()

    valid_platforms = ["hackerone"]
    if platform not in valid_platforms:
        raise HTTPException(
            status_code=400,
            detail=f"Unknown platform {platform!r}. Valid: {valid_platforms}"
