    job_id = f"scrape_{platform}"
    job    = scheduler.get_job(job_id)
    if job is None:
        raise HTTPException(status_code=500, detail=f"Scheduler job {job_id} not found")

    # Trigger the job immediately (bypasses the interval timer for this one run)
    job.modify(next_run_time=datetime.now())
    log.info("scrape_manually_triggered", platform=platform)

    return TriggerResponse(
        status  = "accepted",
        message = f"Scrape job for {platform} queued. Check /health for scheduler status.",
