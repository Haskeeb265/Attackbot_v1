## 6. 🔭 Scope Parser

The `ScopeParser` validates and types raw scope entries, handling the quirks of each asset type.

```python
# backend/services/scraper/scope_parser.py
import ipaddress
import re
from dataclasses import dataclass
from typing import Literal
from shared.logging import get_logger
from .collectors.models import RawScopeEntry

log = get_logger(__name__)

ScopeType      = Literal["in_scope", "out_of_scope"]
ScopeAssetType = Literal["url", "domain", "wildcard_domain", "ip_range", "mobile_app", "api"]


@dataclass
class ParsedScope:
    scope_type: ScopeType
    asset_type: ScopeAssetType
    value:      str
    notes:      str = ""


class ScopeParser:
    """
    Validates and normalises raw scope entries from any platform collector.
    Filters entries with empty or malformed values rather than failing the
    entire program — a bad single scope entry should not block a valid program.
    """

    def parse_all(self, raw_entries: list[RawScopeEntry]) -> list[ParsedScope]:
        parsed: list[ParsedScope] = []
        for entry in raw_entries:
            result = self._parse_entry(entry)
            if result is not None:
                parsed.append(result)
        return parsed

    def _parse_entry(self, entry: RawScopeEntry) -> ParsedScope | None:
        value = entry.value.strip()
        if not value:
            log.warning("scope_entry_empty_value", asset_type=entry.asset_type)
            return None

        asset_type = self._detect_asset_type(entry.asset_type, value)
        if asset_type is None:
            log.warning("scope_entry_unrecognised", value=value, raw_type=entry.asset_type)
            return None

        normalised_value = self._normalise_value(asset_type, value)

        return ParsedScope(
            scope_type = entry.scope_type,
            asset_type = asset_type,
            value      = normalised_value,
            notes      = entry.notes,
        )

    def _detect_asset_type(self, raw_type: str, value: str) -> ScopeAssetType | None:
        # Trust the collector's type mapping first
        valid: set[ScopeAssetType] = {"url", "domain", "wildcard_domain",
                                      "ip_range", "mobile_app", "api"}
        if raw_type in valid:
            return raw_type  # type: ignore

        # Fallback: infer from value shape
        if value.startswith("*."):
            return "wildcard_domain"
        if value.startswith("http://") or value.startswith("https://"):
            return "url"
        if self._is_cidr(value) or self._is_ip(value):
            return "ip_range"
        if re.match(r"^[a-zA-Z0-9][a-zA-Z0-9\-\.]+\.[a-zA-Z]{2,}$", value):
            return "domain"
        if value.startswith("com.") or value.startswith("io."):
            return "mobile_app"   # Android reverse-domain package name

        return None

    def _normalise_value(self, asset_type: ScopeAssetType, value: str) -> str:
        if asset_type == "wildcard_domain":
            # Normalise: *.example.com, .example.com → *.example.com
            if value.startswith("."):
                return f"*{value}"
            return value.lower()

        if asset_type == "domain":
            # Strip trailing dot and lowercase
            return value.rstrip(".").lower()

        if asset_type == "url":
            # Strip trailing slash for consistency
            return value.rstrip("/")

        if asset_type == "ip_range":
            # Validate CIDR; return as-is if valid, strip to host if /32
            return self._normalise_cidr(value)

        return value

    @staticmethod
    def _is_cidr(value: str) -> bool:
        try:
            ipaddress.ip_network(value, strict=False)
            return True
        except ValueError:
            return False

    @staticmethod
    def _is_ip(value: str) -> bool:
        try:
            ipaddress.ip_address(value)
            return True
        except ValueError:
            return False

    @staticmethod
    def _normalise_cidr(value: str) -> str:
        try:
            net = ipaddress.ip_network(value, strict=False)
            # /32 (single host) — return just the host address
            if net.prefixlen == 32:
                return str(net.network_address)
            return str(net)
        except ValueError:
            return value
```

